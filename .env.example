# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Public HTTPS URL of this app. On Render this is filled in automatically from
# RENDER_EXTERNAL_URL — only set it for a custom domain.
WEBHOOK_URL=https://your-domain.com

# Google OAuth (Cloud Console > Credentials > OAuth client, type "Web application").
# Add "<WEBHOOK_URL>/auth/gmail/callback" as an authorised redirect URI, exactly.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key


# Gmail token encryption (generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=your_fernet_key

# Email forwarding inbox — users forward job mail here instead of granting
# access to their whole mailbox. Requires a domain on Cloudflare Email Routing.
# Addresses are u<token>@INBOX_DOMAIN, so use a subdomain like inbox.yourdomain.com.
INBOX_DOMAIN=inbox.yourdomain.com
# Shared secret between the Cloudflare Worker and /inbound/email. Anyone who knows
# it can write applications into any account, so treat it like a password.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INBOUND_SECRET=your_random_secret


# Telegram Stars. Nothing to configure — payments happen inside Telegram, so
# there is no merchant account, no API key and no webhook endpoint. Withdraw
# earnings through @BotFather -> Bot Settings -> Payments.
